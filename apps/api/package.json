{
  "name": "@billing/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:pull": "node --env-file-if-exists=.env ../../node_modules/drizzle-kit/bin.cjs pull --config=drizzle.config.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts --allow-local-mvp"
  },
  "dependencies": {
    "@billing/shared": "workspace:*",
    "@fastify/cors": "latest",
    "@supabase/supabase-js": "latest",
    "date-fns": "latest",
    "decimal.js": "latest",
    "drizzle-orm": "^0.45.4",
    "fastify": "latest",
    "playwright": "latest",
    "postgres": "^4.1.1",
    "zod": "latest"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "latest"
  }
}
